# Shell 또는 GitHub Actions Secrets에 설정. 이 파일은 자동으로 로드하지 않음.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 기본 직접 수집에는 네이버 키가 필요 없음. 위 키는 검색 보완을 켤 때만 사용.
KOSIS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Windows 예: C:/Windows/Fonts/malgun.ttf
# Linux 예: /usr/share/fonts/truetype/nanum/NanumGothicBold.ttf
KOREAN_FONT=
